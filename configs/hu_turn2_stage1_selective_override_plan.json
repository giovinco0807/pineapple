    "all_legal_actions": true,
    "missing_target": 0,
    "output": "outputs/hu_turn2_stage1/hu_turn2_teacher_merged.jsonl",
    "feature_cache": "D:/ofc-pineapple-storage/regular-ofc-pineapple/feature_cache/hu_t2_stage1_mc4096_50k",
    "bucket_mix": {
