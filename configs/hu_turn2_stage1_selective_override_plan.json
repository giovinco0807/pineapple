  "model": {
    "target_checkpoint": "models/hu_turn2_stage1_torch_wide.pt",
    "training_summary": "outputs/hu_turn2_stage1/hu_turn2_stage1_training_summary.json",
    "architecture": {
      "state_encoder": "HU board/dead/seat/to_act features from hu_turn3_model encoder",
      "action_encoder": "placement/discard/next-board action features",
      "baseline_reference_action_encoding": "stored in teacher JSONL; gate model consumes baseline/reference fields",
      "heads": [
        "EV",
        "delta_vs_baseline",
        "delta_vs_reference",
        "rank_listwise",
        "override_gate",
        "uncertainty_optional"
      ]
    },
    "initial_trainer": "ofc_regular.train_torch_hu_turn2_streaming",
    "note": "Initial checkpoint trains the EV action-value head using the generic HU encoder. Delta/gate heads are trained from the same teacher labels after the first teacher validation."
  },
  "loss_plan": {
    "ev": "Huber or weighted MSE initial; Huber target for multi-head trainer",
    "delta_vs_baseline": "Huber",
    "delta_vs_reference": "Huber",
    "ranking": "pairwise ranking loss and margin-weighted listwise loss",
    "gate": "asymmetric gate loss",
    "calibration": "predicted_delta vs teacher_delta calibration loss"
  },
  "gate_label": {
    "positive": "delta_best_vs_baseline >= 0.25 and delta_best_vs_baseline >= 2 * SE_delta",
    "negative": "delta_best_vs_baseline <= 0.05",
