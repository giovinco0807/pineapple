    "recommended_runtime": "outputs/evals/hu_turn2_stage1/hu_turn2_stage1_recommended_runtime.json"
  },
  "adoption_criteria": [
    "aggregate EV/hand is positive versus current T2 baseline",
    "95% CI lower bound is not materially negative",
    "avg_gain_on_override is positive",
    "false_positive_override_rate is low",
    "p95/p99 loss is acceptable",
    "multiple seeds point in the same direction",
    "selective override is stable; full replacement is not enabled"
  ]
